END

!----------------------------------------------------------------------
! SECTION 3 : MECANISME DE SURFACE (SITE AlN_surface)
!----------------------------------------------------------------------
SITE/AlN_surface/ SDEN/1.32E-08/
  AL(S)  N(S)
END

REACTIONS CAL/MOLE
! Croissance AlN - Mecanisme Boichot
ALCL3+N(S)=>AL(S)+3CL          1.00E+14   0.00      0.0 !
NH3+AL(S)=>ALN(B)+N(S)+1.5H2   1.00E+12   0.00      0.0 !
END

