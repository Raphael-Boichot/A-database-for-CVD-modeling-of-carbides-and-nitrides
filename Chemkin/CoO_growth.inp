!----------------------------------------------------------------------
! SECTION 1 : ELEMENTS ET ESPECES
!----------------------------------------------------------------------
ELEMENTS
  CO  O  N  C  H
END

SPECIES
  CO(ACAC)3  CO(ACAC)2  N2  O  O2  STYRENE  ACAC  M
END

!----------------------------------------------------------------------
! SECTION 2 : MECANISME DE VOLUME (PHASE GAZEUSE)
!----------------------------------------------------------------------
REACTIONS  CAL/MOLE
! Unites : A (cm, mol, s), n (sans unite), Ea (cal/mol)
! Ea calculee par (Ea/R en Kelvin) * 1.9872

CO(ACAC)3+M=>CO(ACAC)2+ACAC+M  2.46E+11   0.50   25833.6 ! [cite: 19]
2O+M=>O2+M                     1.03E+11   0.50       0.0 ! [cite: 19]
END

!----------------------------------------------------------------------
! SECTION 3 : MECANISME DE SURFACE (SITE surface_react)
!----------------------------------------------------------------------
SITE/surface_react/ SDEN/1.00E-09/
  CO(S)  O(S)
END

REACTIONS  CAL/MOLE
! Croissance MoO - Equations de surface brutes
CO(ACAC)2+O(S)=>2ACAC+COO(B)+CO(S)   1.00E+14   0.00   0.0 ! [cite: 20]
END

