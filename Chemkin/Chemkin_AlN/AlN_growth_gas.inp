!----------------------------------------------------------------------
! GAS-PHASE MECHANISM FOR ALN GROWTH (Updated from .out kinetics)
!----------------------------------------------------------------------

ELEMENTS
  AL CL N H
END

SPECIES
  ALCL3 NH3 ALCL2NH2 HCL H CL CL2 H2
END

REACTIONS KELVINS

ALCL3 + NH3 = ALCL2NH2 + HCL                4.210E+08   0.000   4200.0
H + CL + M = HCL + M                        7.200E+21  -2.000      0.0
2CL + M = CL2 + M                           2.000E+14   0.000   -900.0
HCL + H = CL + H2                           1.690E+13   0.000   2100.0
H + CL2 = HCL + CL                          8.600E+13   0.000    590.0
2H + H2 = 2H2                               9.700E+16  -0.600      0.0
H2 + M = 2H + M                             2.200E+14   0.000  48000.0

END