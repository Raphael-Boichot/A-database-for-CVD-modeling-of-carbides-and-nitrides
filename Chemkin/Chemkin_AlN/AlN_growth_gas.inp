!----------------------------------------------------------------------
! GAS-PHASE MECHANISM FOR ALN GROWTH
!----------------------------------------------------------------------

ELEMENTS
  AL CL N H
END

SPECIES
  ALCL3 NH3 ALCL2NH2 HCL H CL CL2 H2
END

REACTIONS  CAL/MOLE
!
! 1. Formation of Intermediate
ALCL3 + NH3 = ALCL2NH2 + HCL                4.21E+08   0.00   8346.2 
!
! 2. Recombination/Dissociation with Third Body (M)
H + CL + M = HCL + M                        7.20E+21  -2.00      0.0 
2CL + M = CL2 + M                           2.00E+14   0.00  -3558.1 
H2 + M = 2H + M                             2.20E+14   0.00 190987.8
!
! 3. Exchange Reactions
H + HCL = CL + H2                           1.69E+13   0.00   8222.0 
CL2 + H = CL + HCL                          8.60E+13   0.00   2329.8 
!
! 4. H2-Specific Recombination
2H + H2 = 2H2                               9.70E+16  -0.60      0.0 

END