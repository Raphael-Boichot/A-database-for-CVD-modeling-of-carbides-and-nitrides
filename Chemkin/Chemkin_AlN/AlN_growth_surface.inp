!----------------------------------------------------------------------
! SURFACE MECHANISM
!----------------------------------------------------------------------

SITE/AlN_surface/ SDEN/1.32E-08/
  E(S)  N(S)
END

BULK ALN(B) / 3.26 /

REACTIONS KELVINS

! E(S) has a mass of zero to mimics the original mechanism and fit with the CHEMKIN formalism (mass balanced forced)
! consider E(S) as an aluminium open site and it is the same as the original mechanism
ALCL3 + N(S) => ALN(B) + E(S) + 3CL          2.385E+11   0.50   7700.0
NH3 + E(S) => N(S) + 1.5H2                   6.680E+11   0.50   8654.0
ALCL2NH2 + E(S) => 2HCL + ALN(B) + E(S)      2.580E+11   0.50   5100.0
ALCL2NH2 + N(S) => 2HCL + ALN(B) + N(S)      2.580E+11   0.50   5100.0

END
