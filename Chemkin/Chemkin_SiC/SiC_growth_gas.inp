!----------------------------------------------------------------------
! Gas Mechanism File for SiC Growth Simulation
!----------------------------------------------------------------------

ELEMENTS
  C CL SI H N
END

SPECIES
    H2          H           SIH4        SIH2        SI2H6       
    SI_G        C3H8        CH3         C2H5        CH4         
    C2H6        C2H4        C2H2        H3SICH3     HSICH3      
    SICH2       CH2         CL2         CL          HCL         
    SICL4       SIHCL3      SI2         SI2C        N2
END

!----------------------------------------------------------------------
! SANITIZED GAS-PHASE KINETICS (COMPILER CONSTRAINTS SATISFIED)
! Reversible (<=>) reactions automatically account for backward paths.
! Units: A [cm, mol, s], Ea [cal/mol]
!----------------------------------------------------------------------
REACTIONS
!
SIH4 <=> SIH2 + H2                              2.000E+13   0.000   5.840E+04
SI2H6 <=> SIH4 + SIH2                           6.300E+14   0.000   4.950E+04
C3H8 <=> CH4 + C2H4                             2.800E+16   0.000   8.210E+04
CH4 + H <=> CH3 + H2                            2.200E+04   3.000   8.750E+03
C2H6 <=> 2 CH3                                  5.500E+16   0.000   8.830E+04
C2H5 + H2 <=> C2H6 + H                          5.000E+05   2.500   1.150E+04
2 C2H5 <=> C2H4 + C2H6                          1.200E+12   0.000   0.000E+00
C2H4 <=> C2H2 + H2                              1.300E+12   0.000   7.700E+04
H3SICH3 <=> HSICH3 + H2                         1.500E+14   0.000   6.500E+04
SIH4 + CH3 <=> H3SICH3 + H                      4.000E+11   0.000   6.500E+03
CH4 <=> CH2 + H2                                3.000E+15   0.000   1.020E+05
END