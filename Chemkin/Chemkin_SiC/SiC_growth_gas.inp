!----------------------------------------------------------------------
! Gas Mechanism File for SiC Growth Simulation adapted from CFD-ACE
!----------------------------------------------------------------------

ELEMENTS
  C CL SI H N
END

SPECIES
    H2          H           SIH4        SIH2        SI2H6       
    SI_G        C3H8        CH3         C2H5        CH4         
    C2H6        C2H4        C2H2        H3SICH3     HSICH3      
    SICH2       CH2         CL2         CL          HCL         
    SICL4       SIHCL3      SI2         SI2C        N2
END

REACTIONS KELVINS

SIH4 <=> SIH2 + H2             6.671E+29    -4.795   31946
SI2H6 <=> SIH2 + SIH4          3.240E+29    -4.240   29202
